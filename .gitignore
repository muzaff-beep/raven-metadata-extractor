```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python build artifacts
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
dist/
build/
*.dist-info/

# Development environments
.venv/
venv/
.env
.env.local
*.env.*

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Coverage reports
.coverage
htmlcov/
coverage/

# Testing
.pytest_cache/
.mypy_cache/
```